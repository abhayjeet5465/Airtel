# Copy to .env (never commit .env). Leave Supabase blank to run fully local with the in-memory store.

# Server-side only
DATASET_DIR=../YTL_TrackA_Udyam_Digital_Data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run migrate` — set ONE of these locally, never on Vercel:
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
OCR_SERVICE_URL=http://127.0.0.1:8790

# Browser (public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

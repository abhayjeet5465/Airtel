{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["hnd1"],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
